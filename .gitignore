# Rust build output (P7.07). The crate's *installed* artifact,
# packages/wasm-core/src/generated/ballista-core.wasm, IS committed on purpose --
# CI has no Rust toolchain, so without it the equivalence test would skip and
# P7.07's criterion would be checked nowhere. See packages/wasm-core/README.md.
# `target/` is the intermediate build tree and is not.
target/


# P7.09 builds a second artifact with -C target-feature=+simd128 into its own
# CARGO_TARGET_DIR, because cargo keys its fingerprint on RUSTFLAGS and a shared
# directory would make the two builds invalidate each other.
target-simd/
